task_name: train_flight
tags:
- flight
train: true
test: false
compile: false
inference: false
ckpt_path:
- - [PATH TO CKPT]
seed: 42
profiler: simple
data:
  _target_: src.data.flight_datamodule.FlightDataModule
  train_data_path:
  - ${paths.data_dir}/train
  eval_data_path:
  - ${paths.data_dir}/eval
  mode: IL
  buffer_size: 1000
  snippet_size: 100
  use_standardize: false
  use_clip_preprocess: false
  use_lavis_preprocess: true
  lavis_preprocess_cfg:
    name: BlipImageEvalProcessor
  use_rejection_sampling: true
  batch_size: 1
  num_workers: 1
  pin_memory: false
  persistent_workers: true
model:
  net:
    extractor:
      _target_: src.models.components.extractors.blip.BLIPExtractor
      name: blip2_feature_extractor
      model_type: pretrain
      freeze_blip: true
      use_low_dim_feature: false
      use_visual_encoder_only: false
      last_linear_layer:
      - 768
      - 64
      checkpoint: ${paths.pretrained_blip_dir}/blip2_pretrained.pth
      use_continuous_pe: false
      stride: 14
    policy:
      _target_: src.models.components.policies.conv.ConvPolicy
      fc_cfg:
      - 64
      - 128
      - 128
      - 128
      - 4
      fc_bias: true
      norm_cfg:
        type: null
      act_cfg:
        type: relu
        inplace: true
      dropout_p: 0.3
    _target_: src.models.components.e2e_net.E2ENet
    output_names:
    - vx
    - vy
    - vz
    - yaw
  _target_: src.models.flight_module.FlightLitModule
  optimizer:
    _target_: torch.optim.Adam
    _partial_: true
    lr: 0.0001
    weight_decay: 0.0
  scheduler:
    _target_: torch.optim.lr_scheduler.ReduceLROnPlateau
    _partial_: true
    mode: min
    factor: 0.1
    patience: 10
  criterion:
    _target_: src.models.components.criterion.MSECriterion
    weights:
      vx: 1
      vy: 1
      vz: 1
      yaw: 1
    reduction: mean
  closed_loop_eval_cfg:
    max_steps: 300
    n_episodes: 1
callbacks:
  model_checkpoint:
    _target_: lightning.pytorch.callbacks.ModelCheckpoint
    dirpath: ${paths.output_dir}/checkpoints
    filename: step_{step:06d}
    monitor: null
    verbose: false
    save_last: true
    save_top_k: -1
    mode: min
    auto_insert_metric_name: false
    save_weights_only: false
    every_n_train_steps: 25000
    train_time_interval: null
    every_n_epochs: null
    save_on_train_epoch_end: null
  model_summary:
    _target_: lightning.pytorch.callbacks.RichModelSummary
    max_depth: -1
  rich_progress_bar:
    _target_: lightning.pytorch.callbacks.RichProgressBar
  early_stopping:
    monitor: val/acc
    patience: 100
    mode: max
  backbone_finetuning:
    _target_: lightning.pytorch.callbacks.BackboneFinetuning
    unfreeze_backbone_at_epoch: 9999
    train_bn: false
logger:
  csv:
    _target_: lightning.pytorch.loggers.csv_logs.CSVLogger
    save_dir: ${paths.output_dir}
    name: csv/
    prefix: ''
  tensorboard:
    _target_: lightning.pytorch.loggers.tensorboard.TensorBoardLogger
    save_dir: ${paths.output_dir}/tensorboard/
    name: null
    log_graph: false
    default_hp_metric: true
    prefix: ''
trainer:
  _target_: lightning.pytorch.trainer.Trainer
  default_root_dir: ${paths.output_dir}
  min_epochs: 1
  max_epochs: 1
  accelerator: gpu
  devices: 1
  check_val_every_n_epoch: 1
  deterministic: false
  max_steps: 1000000
  limit_val_batches: 10
  val_check_interval: 2000
  strategy: ddp_find_unused_parameters_true
paths:
  root_dir: ${oc.env:PROJECT_ROOT}
  data_dir: ${oc.env:DATA_DIR}
  log_dir: ${oc.env:LOG_DIR}
  pretrained_clip_dir: ${oc.env:PRETRAINED_CLIP_DIR}
  pretrained_blip_dir: ${oc.env:PRETRAINED_BLIP_DIR}
  pretrained_sam_dir: ${oc.env:PRETRAINED_SAM_DIR}
  output_dir: ${hydra:runtime.output_dir}
  work_dir: ${hydra:runtime.cwd}
extras:
  ignore_warnings: false
  enforce_tags: true
  print_config: true
pytorch_sharing_strategy: file_system
